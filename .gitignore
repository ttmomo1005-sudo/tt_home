# Default deny: only reviewed website source and media are tracked.
*
!/.gitignore
!/README.md
!/index.html
!/package.json
!/package-lock.json
!/tsconfig.json
!/vite.config.ts

!/src/
!/src/*.ts
!/src/*.tsx
!/src/*.css
!/public/
!/public/works/
!/public/works/*.jpg
!/public/works/*.png
!/public/works/*.mp4

!/redesign/
!/redesign/README.md
!/redesign/index.html
!/redesign/package.json
!/redesign/package-lock.json
!/redesign/tsconfig.json
!/redesign/vite.config.ts
!/redesign/src/
!/redesign/src/*.ts
!/redesign/src/*.tsx
!/redesign/src/*.css
!/redesign/public/
!/redesign/public/works/
!/redesign/public/works/*.jpg
!/redesign/public/works/*.png
!/redesign/public/works/*.mp4

# Keep private files out even when placed inside an allowed directory.
**/.env
**/.env.*
**/*.local
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.crt
**/*.cer
**/*.csr
**/*.log
**/micro-duck-sale.*
**/node_modules/
**/dist/
